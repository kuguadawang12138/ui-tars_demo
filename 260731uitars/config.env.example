# ===== 默认：本地部署 UI-TARS-1.5-7B（推荐） =====
# 服务器上先运行: bash install.sh && bash scripts/start_vllm.sh
# Windows 客户端连接服务器 IP（或本机 127.0.0.1 若模型跑在本机）
UI_TARS_PROVIDER=local
UI_TARS_BASE_URL=http://127.0.0.1:8000/v1/
UI_TARS_API_KEY=EMPTY
UI_TARS_MODEL=UI-TARS-1.5-7B
UI_TARS_MODEL_TYPE=doubao

# ===== 可选：云端 API 调试（不推荐生产使用） =====
# UI_TARS_PROVIDER=zhipu
# UI_TARS_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# UI_TARS_API_KEY=your_api_key_here
# UI_TARS_MODEL=glm-4.6v
# UI_TARS_MODEL_TYPE=glm
